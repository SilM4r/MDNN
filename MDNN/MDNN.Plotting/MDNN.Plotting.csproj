<Project Sdk="Microsoft.NET.Sdk">

  <!-- Grafy průběhu tréninku. Samostatně, ať jádro knihovny nemusí táhnout ScottPlot
       (a s ním vykreslovací závislosti) jen kvůli jednomu obrázku. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>MDNN.Plotting</PackageId>
    <Version>1.0.0</Version>
    <Authors>SilM4r</Authors>
    <Description>Loss charts for MDNN training runs (ScottPlot). Call model.Train.UseLossChart() to save loss.png at the end of TrainLoop.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SilM4r/MDNN</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SilM4r/MDNN</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>neural-network;mdnn;plotting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot" Version="5.0.54" />
    <ProjectReference Include="..\MDNN\MDNN.csproj" />
  </ItemGroup>

</Project>
