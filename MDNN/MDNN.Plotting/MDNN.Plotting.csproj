<Project Sdk="Microsoft.NET.Sdk">

  <!-- Training loss charts. A separate package so the core library does not have to pull in
       ScottPlot (and its rendering dependencies) just for one image. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>MDNN.Plotting</PackageId>
    <Version>1.0.0</Version>
    <Authors>SilM4r</Authors>
    <Description>Loss charts for MDNN training runs (ScottPlot). Call model.Train.UseLossChart() to save loss.png at the end of TrainLoop.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SilM4r/MDNN</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SilM4r/MDNN</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>neural-network;mdnn;plotting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- XML docs ship with the package so IntelliSense shows them; a public member without
         docs is a build warning. Symbols go to a separate .snupkg. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot" Version="5.0.54" />
    <ProjectReference Include="..\MDNN\MDNN.csproj" />
  </ItemGroup>

</Project>
