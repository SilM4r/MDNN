<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The app targets net9.0 but may run on a machine that only has a newer runtime
         installed (typically Rider with its own .NET in ~/.dotnet). Without this, startup
         fails with "The following frameworks were found: 10.0.8" and exit code 150,
         because rolling forward across a MAJOR runtime version is off by default.
         LatestMajor = "run on the newest one available". -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDNN\MDNN.csproj" />
    <ProjectReference Include="..\MDNN.Plotting\MDNN.Plotting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference values from PyTorch for TorchParityTests. They are committed so CI
         does not need Python; regenerate them with tools/torch_fixtures/. -->
    <Content Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
